{
  "name": "@interlacejs/core",
  "version": "0.1.0",
  "description": "Shared definitions and logic with no rendering opinions.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "keywords": [
    "interlace",
    "interactive-video",
    "edtech",
    "lms"
  ],
  "author": {
    "name": "Joshua Farayola",
    "email": "farayolajoshua@gmail.com"
  },
  "license": "ISC",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts*\"",
    "test": "vitest run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:^",
    "tsup": "^8.5.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {}
}